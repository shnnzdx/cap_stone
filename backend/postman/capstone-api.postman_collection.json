        },
        {
          "name": "GET Alert Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alerts/1"
          }
        },
        {
          "name": "POST Create Alert Manual",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/alerts",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": 1,\n  \"severity\": 4,\n  \"score\": 0.87,\n  \"utility\": 0.82,\n  \"decision\": \"promote\",\n  \"decision_reason\": \"Manual test alert\",\n  \"confidence\": 0.91,\n  \"is_duplicate\": false,\n  \"is_actionable\": true\n}"
            }
          }
        },
        {
          "name": "PATCH Acknowledge Alert",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/alerts/1",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"acknowledged\"\n}"
            }
          }
        },
        {
          "name": "GET Alerts Filtered",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/alerts?status=open&decision=promote",
              "host": ["{{baseUrl}}"],
              "path": ["alerts"],
              "query": [
                {"key": "status", "value": "open"},
                {"key": "decision", "value": "promote"}
              ]
            }
          }
        }
      ]
    },
