      "item": [
        {
          "name": "GET List Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs"
          }
        },
        {
          "name": "POST Create Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"job_name\": \"payment-settlement\",\n  \"worker_id\": \"worker-07\",\n  \"status\": \"timeout\",\n  \"duration_ms\": 12400,\n  \"api_latency_ms\": 830,\n  \"retry_count\": 4,\n  \"error_count\": 2,\n  \"queue_delay_ms\": 1800\n}"
            }
          }
        },
        {
          "name": "POST Evaluate Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/1/evaluate",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"feedback\"\n}"
            }
          }
        },
        {
          "name": "GET Jobs Filtered",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?service_id=1&status=timeout",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                {"key": "service_id", "value": "1"},
                {"key": "status", "value": "timeout"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Alerts",
      "item": [
        {
          "name": "GET List Alerts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alerts"
