{
  "info": {
    "name": "Capstone Alert Triage Engine API",
    "description": "Postman collection for Assignment 2 backend API testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "2. Services",
      "item": [
        {
          "name": "GET List Services",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services"
          }
        },
        {
          "name": "POST Create Service",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/services",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"inventory-sync\",\n  \"owner_team\": \"operations\",\n  \"criticality\": \"medium\",\n  \"description\": \"Nightly inventory synchronization workflow\"\n}"
            }
          }
        },
        {
          "name": "GET Service Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services/1"
          }
        }
      ]
    },
    {
