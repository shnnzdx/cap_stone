DATABASE_URL=postgresql+psycopg://localhost/tripsync
TEST_DATABASE_URL=postgresql+psycopg://localhost/tripsync_test
OPENAI_API_KEY=
# OpenAI-compatible runtime keys:
# - DeepSeek cloud: OPENAI_BASE_URL=https://api.deepseek.com
# - Local Ollama: OPENAI_API_KEY=ollama + OPENAI_BASE_URL=http://localhost:11434/v1/
# - Ollama Cloud: use a real cloud API key + OPENAI_BASE_URL=https://ollama.com/v1/
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MOCK_AI=1
SETTLE_TICK_SECONDS=60
DISABLE_SCHEDULER=0
DEV_ALLOW_MEMBERSHIP_HEADER=1
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
